package oop;
import java.util.Scanner; 

public class jjjj {

  public static void main(String[] args) {
    // TODO Auto-generated method stub
    Scanner input = new Scanner(System.in);
    
    String name = input.nextLine();
    
    int len = name.length(); 
    
    System.out.print("+");
    
    for (int i = 0; i < len; i++) {
      System.out.print("-");
    }
    
    System.out.println("+");
    
    System.out.println("|" + name + "|");
    
    System.out.print("+");
    
    for (int i = 0; i < len; i++) {
      System.out.print("-");
    }
    System.out.println("+");

    input.close(); 

  }

}